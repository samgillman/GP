  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "pyodide": "0.29.3",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
